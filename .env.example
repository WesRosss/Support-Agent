# Domein waarop de webapp bereikbaar is via HTTPS (Let's Encrypt).
# Het DNS A-record van dit domein moet naar het openbare IP van deze server wijzen.
# Poorten 80 en 443 moeten open staan / forwarded zijn naar deze server.
DOMAIN=app.jouwdomein.nl

# Gedeelde API-key voor de Windows-client (wordt verstuurd als header X-API-Key).
# Genereer bijvoorbeeld met: openssl rand -hex 32
APP_API_KEY=vervang-door-een-lange-willekeurige-sleutel

# Mistral API-key (dezelfde als in je Vibe-account). Wordt alleen server-side gebruikt.
MISTRAL_API_KEY=

# Mistral model voor de verwerking
MISTRAL_MODEL=mistral-large-latest
